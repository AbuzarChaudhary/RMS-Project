# The frontend talks to the backend at /api, which the Vite dev proxy
# (see vite.config.js) forwards to http://localhost:4000. So for local dev
# you normally do NOT need to set anything here.
#
# Set this only if your backend runs somewhere else and you are not using
# the dev proxy:
# VITE_API_BASE_URL=http://localhost:4000/api
